# ==============================================================================
# Job-Hunter Environment Configuration (Optional)
# ==============================================================================
# Copy this file to .env and fill in your values if you wish to enable optional
# Cloud AI features or customize browser connection ports.

# Google Gemini API Key for AI-powered recruiter messaging (optional)
# Get one at: https://aistudio.google.com/
GEMINI_API_KEY=

# Model to use for LinkedIn Agent response drafting
LINKEDIN_AGENT_MODEL=gemini-2.5-flash

# Chrome DevTools Protocol (CDP) port for attaching to your existing browser session
CDP_PORT=9222

# Optional override for CV file path (default is read dynamically from candidate-profile.md)
DEFAULT_CV_PATH=
